{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "game",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/game/node_modules/vite/bin/vite.js", "apps/game", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@soul-monster/web", "dev"],
      "port": 5174
    },
    {
      "name": "game-build-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["preview", "--port", "4173", "--strictPort"],
      "port": 4173
    }
  ]
}
